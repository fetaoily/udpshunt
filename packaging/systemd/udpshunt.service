[Unit]
Description=udpshunt UDP load balancer
Documentation=https://github.com/fetaoily/udpshunt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/udpshunt -c /etc/udpshunt/udpshunt.yaml
Restart=always
RestartSec=5
# Every session holds a socket; systemd's default 1024/4096 ceiling makes
# dials (and probe dials) fail under a few thousand concurrent sessions.
LimitNOFILE=65536
# No capabilities are requested here on purpose: kernels < 4.3 (e.g. CentOS 7
# with systemd 219) cannot apply ambient capabilities, and systemd there fails
# the whole spawn with status=218/CAPABILITIES if AmbientCapabilities is set.
# As User=nobody the daemon can bind ports >= 1024. To bind low ports (e.g.
# :53) on a kernel >= 4.3 system, add this drop-in:
#   # /etc/systemd/system/udpshunt.service.d/lowport.conf
#   [Service]
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=
# Spec §10: the daemon owns no persistent state, so a private /tmp and
# read-only filesystem are safe.
PrivateTmp=true
# The per-request log (request_log.dir default /var/log/udpshunt): created
# and chowned to User= at start; also exempt from ProtectSystem=strict.
# Ignored by systemd < 240 — udpshunt then logs a warning and runs without
# the request log.
LogsDirectory=udpshunt
User=nobody

[Install]
WantedBy=multi-user.target
